# ═══════════════════════════════════════════════
# CROWN REGISTRY — Environment Variables Template
# Copy this to .env.local and fill in all values
# ═══════════════════════════════════════════════

# ── APP ──────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Crown Registry"
NEXT_PUBLIC_APP_TAGLINE="The World's Finest Marketplace"

# ── DATABASE ─────────────────────────────────
# PostgreSQL (Supabase, Neon, Railway, or self-hosted)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/crown_registry?schema=public"
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@HOST:5432/crown_registry"

# ── REDIS ────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# Or Upstash for serverless:
# REDIS_URL="rediss://USER:PASSWORD@HOST:PORT"

# ── AUTH ─────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth
APPLE_ID=
APPLE_SECRET=

# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ── STRIPE ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── PAYPAL ───────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_WEBHOOK_ID=

# ── AWS S3 ───────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_S3_BUCKET=crown-registry-media

# ── CLOUDFLARE R2 (CDN) ──────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=crown-registry-cdn
NEXT_PUBLIC_CDN_URL=https://cdn.crownregistry.com

# ── ELASTICSEARCH ────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX_PREFIX=crown_

# ── EMAIL (RESEND) ───────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="Crown Registry <hello@crownregistry.com>"
EMAIL_REPLY_TO="support@crownregistry.com"

# ── GOOGLE MAPS ──────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
GOOGLE_MAPS_SERVER_KEY=

# ── SMS (TWILIO) ──────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── AI (OPENAI) ──────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=

# ── MONITORING ───────────────────────────────
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# ── ANALYTICS ────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-...
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── INTERNAL ─────────────────────────────────
CRON_SECRET="generate-with: openssl rand -hex 32"
ADMIN_EMAIL=admin@crownregistry.com
COMMISSION_RATE_DEFAULT=5
ESCROW_PROVIDER_KEY=

# ── FEATURE FLAGS ────────────────────────────
NEXT_PUBLIC_ENABLE_AUCTIONS=true
NEXT_PUBLIC_ENABLE_CHARTER=true
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_VIDEO_CALLS=false
